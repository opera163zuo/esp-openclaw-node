---
import { getRelativeLocaleUrl } from "astro:i18n";

const mainPage = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "/");
const docsPage = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "/tutorial/");
---

<div class="site-title sl-flex">
  <span class="project-name-text">ESP-OpenClaw-Node</span>
  <span class="divider"></span>
  <a class="docs-name" href={docsPage} aria-label="Docs">Docs</a>
</div>

<style>
  .site-title {
    gap: 1rem;
    align-items: center;
    justify-content: center;
    display: flex;
  }
  .project-name-text {
    display: flex;
    align-items: center;
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }
  .docs-name {
    color: var(--sl-color-text-accent);
    display: flex;
    align-items: center;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .divider {
    width: 1px;
    height: 100%;
    background-color: var(--sl-color-gray-4);
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:focus-visible > :global(*) {
    outline: auto;
    outline-offset: 0.33rem;
    border-radius: 1px;
  }
  .site-title :global(svg) {
    margin-block: 0;
    transition: transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .project-logo :global(svg) {
    height: 2rem;
    width: auto;
  }
</style>
