menu "Test App Config"

    # app_config.h maps these two onto APP_WIFI_SSID / APP_WIFI_PASSWORD, so the
    # symbols have to exist for that component to compile. These tests never
    # touch a real network, so the values do not matter.

    config APP_WIFI_SSID
        string "Default Wi-Fi SSID"
        default ""

    config APP_WIFI_PASSWORD
        string "Default Wi-Fi password"
        default ""

    # http_server's manifest gates lua_module_http_server on this symbol, and
    # app_claw is deliberately not part of this build, so nothing else would
    # define it. Off, which is what keeps that component out too.

    config APP_CLAW_CAP_LUA
        bool "app_claw Lua capability (absent in this test build)"
        default n

endmenu
